# Copia este archivo como .env.local (en tu Mac) o pega cada valor en Vercel → Settings → Environment Variables.
# Nunca subas los valores reales a GitHub.

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shopify → Configuración → Notificaciones → Webhooks (la clave con la que se firman).
# Si son varias tiendas, sepáralas con coma.
SHOPIFY_WEBHOOK_SECRETS=

# Contraseña para entrar a la app
APP_PASSWORD=

# Dropi → Integraciones → Bravo IA → token de la integración
DROPI_INTEGRATION_KEY=
# Opcional: solo si Dropi da otra dirección para la API
# DROPI_API_URL=https://api.dropi.co/integrations
